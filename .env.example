# Server
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=

# Optional AI adapter. When omitted, the app uses the tested local MVP engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase persistence. Leave blank for local demo mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API placeholders for the production adapter.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=tuition-hub
WHATSAPP_GRAPH_VERSION=v20.0

# Google Calendar live availability. Prefer refresh-token OAuth for production.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional short-lived override for local testing only.
GOOGLE_CALENDAR_ACCESS_TOKEN=
