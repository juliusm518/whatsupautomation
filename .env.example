# Server
PORT=3000
HOST=127.0.0.1

# Optional AI adapter. When omitted, the app uses the tested local MVP engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase persistence. Leave blank for local demo mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API placeholders for the production adapter.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=tuition-hub
WHATSAPP_GRAPH_VERSION=v20.0
